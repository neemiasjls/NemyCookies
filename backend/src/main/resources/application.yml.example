spring:
  datasource:
    url: ${DB_URL:jdbc:mysql://localhost:3306/nemycookies?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true}
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:troque-esta-senha}
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQL8Dialect

server:
  port: ${SERVER_PORT:5000}

# Credenciais do painel admin — TROQUE antes de usar em producao
admin:
  username: ${ADMIN_USERNAME:admin}
  password: ${ADMIN_PASSWORD:troque-esta-senha}

# JWT — gere uma chave aleatoria com no minimo 32 caracteres
jwt:
  secret: ${JWT_SECRET:gere-uma-chave-secreta-aleatoria-de-no-minimo-32-caracteres}
  expiration: ${JWT_EXPIRATION:86400000}

# Mercado Pago — pegue as chaves no painel do Mercado Pago
mercadopago:
  access-token: ${MP_ACCESS_TOKEN:SEU_ACCESS_TOKEN}
  public-key: ${MP_PUBLIC_KEY:SUA_PUBLIC_KEY}
  webhook-secret: ${MP_WEBHOOK_SECRET:gere-um-segredo-forte-para-o-webhook}
